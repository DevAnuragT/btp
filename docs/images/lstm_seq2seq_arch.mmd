graph LR
    subgraph "Input Sequence (28 Days)"
        X1["Day t-27"] 
        X2["Day t-1"]
        FE["Engineered Features: stockout_streak, stockout_rolling_7, sale_amount_lag1"]
    end

    subgraph "Encoder RNN / LSTM"
